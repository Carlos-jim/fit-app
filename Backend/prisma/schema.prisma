generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogType {
  MEAL_ANALYSIS
}

enum LogSource {
  IMAGE
  TEXT
}

enum AnalysisConfidence {
  LOW
  MEDIUM
  HIGH
}

enum GoalType {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_WEIGHT
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum WorkoutFrequency {
  LOW
  MEDIUM
  HIGH
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum PlanType {
  FREE
  PRO
  ULTRA
}

enum EmailTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum BodyMetricType {
  WEIGHT_KG
  WAIST_CM
  HIP_CM
  CHEST_CM
  BODY_FAT_PCT
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  fullName         String?
  passwordHash     String?
  authProvider     AuthProvider       @default(EMAIL)
  plan             PlanType           @default(FREE)
  planStartedAt    DateTime?
  planExpiresAt    DateTime?
  emailVerified    Boolean            @default(false)
  emailVerifiedAt  DateTime?
  logs             Log[]
  onboardingSession OnboardingSession?
  profile          UserProfile?
  nutritionPlan    NutritionPlan?
  bodyMetrics      BodyMetric[]
  hydrationLogs    HydrationLog[]
  workouts         Workout[]
  tips             Tip[]
  refreshTokens    RefreshToken[]
  emailTokens      EmailToken[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OnboardingSession {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             GoalType?
  weightKg         Float?
  heightCm         Float?
  desiredWeightKg  Float?
  gender           Gender?
  age              Int?
  country          String?
  workoutFrequency WorkoutFrequency?
  activityLevel    ActivityLevel?
  dietaryPrefs     Json?
  completed        Boolean           @default(false)
  currentStep      Int               @default(1)
  totalSteps       Int               @default(7)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Log {
  id                    String             @id @default(cuid())
  userId                String
  type                  LogType            @default(MEAL_ANALYSIS)
  source                LogSource          @default(IMAGE)
  title                 String?
  notes                 String?
  imageBucket           String?
  imageKey              String?
  imageUrl              String?
  consumedAt            DateTime?
  estimatedServingGrams Float?
  calories              Float
  proteinGrams          Float
  carbsGrams            Float
  fatGrams              Float
  fiberGrams            Float?
  sugarGrams            Float?
  sodiumMg              Float?
  confidence            AnalysisConfidence
  aiModel               String
  ingredients           Json
  warnings              Json?
  rawAnalysis           Json
  aiSuggestion          Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

model UserProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             GoalType?
  weightKg         Float?
  heightCm         Float?
  desiredWeightKg  Float?
  gender           Gender?
  age              Int?
  country          String?
  workoutFrequency WorkoutFrequency?
  activityLevel    ActivityLevel?
  dietaryPrefs     Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model NutritionPlan {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalories     Int
  proteinGrams      Int
  carbsGrams        Int
  fatGrams          Int
  proteinPercentage Int
  carbsPercentage   Int
  fatPercentage     Int
  bmr               Float?
  tdee              Float?
  source            String   @default("mifflin_st_jeor")
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BodyMetric {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      BodyMetricType
  value     Float
  unit      String
  notes     String?
  recordedAt DateTime     @default(now())
  createdAt DateTime      @default(now())

  @@index([userId, type, recordedAt(sort: Desc)])
  @@index([userId, recordedAt(sort: Desc)])
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Tip {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  category    String
  icon        String?
  weekYear    String
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, weekYear])
}

model HydrationLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  glasses    Int
  notes      String?
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, recordedAt])
}

enum WorkoutType {
  STRENGTH
  CARDIO
  FLEXIBILITY
  HIIT
  SPORT
}

model Workout {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       WorkoutType
  name       String
  durationMinutes Int
  caloriesBurned   Int?
  intensity  String?
  notes      String?
  performedAt DateTime
  createdAt  DateTime    @default(now())

  sets       WorkoutSet[]

  @@index([userId, performedAt])
}

model WorkoutSet {
  id          String   @id @default(cuid())
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    String
  reps        Int?
  weightKg    Float?
  durationSec Int?
  distanceMeters Float?
  orderIndex  Int      @default(0)

  @@index([workoutId, orderIndex])
}
