generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogType {
  MEAL_ANALYSIS
}

enum LogSource {
  IMAGE
  TEXT
}

enum AnalysisConfidence {
  LOW
  MEDIUM
  HIGH
}

enum GoalType {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_WEIGHT
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum WorkoutFrequency {
  LOW
  MEDIUM
  HIGH
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum PlanType {
  FREE
  PRO
  ULTRA
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  fullName         String?
  passwordHash     String?
  authProvider     AuthProvider       @default(EMAIL)
  plan             PlanType           @default(FREE)
  planStartedAt    DateTime?
  planExpiresAt    DateTime?
  logs             Log[]
  onboardingSession OnboardingSession?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model OnboardingSession {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             GoalType?
  weightKg         Float?
  heightCm         Float?
  desiredWeightKg  Float?
  gender           Gender?
  age              Int?
  country          String?
  workoutFrequency WorkoutFrequency?
  activityLevel    ActivityLevel?
  dietaryPrefs     Json?
  completed        Boolean           @default(false)
  currentStep      Int               @default(1)
  totalSteps       Int               @default(7)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Log {
  id                    String             @id @default(cuid())
  userId                String
  type                  LogType            @default(MEAL_ANALYSIS)
  source                LogSource          @default(IMAGE)
  title                 String?
  notes                 String?
  imageBucket           String?
  imageKey              String?
  imageUrl              String?
  consumedAt            DateTime?
  estimatedServingGrams Float?
  calories              Float
  proteinGrams          Float
  carbsGrams            Float
  fatGrams              Float
  fiberGrams            Float?
  sugarGrams            Float?
  sodiumMg              Float?
  confidence            AnalysisConfidence
  aiModel               String
  ingredients           Json
  warnings              Json?
  rawAnalysis           Json
  aiSuggestion          Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}
