# Backend environment variables for Bioma
# Copy this file to .env and fill in the real values.
# NEVER commit .env to Git.

# ─── Database ──────────────────────────────────────────────────────
# Use the pooled connection string from Neon: add -pooler before the first dot.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# ─── AI (Google Gemini) ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# ─── Supabase Storage ──────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=fit_bucket
STORAGE_SIGNED_UPLOAD_TTL_SECONDS=7200

# ─── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Auth (generate strong random strings in production) ──────────
JWT_ACCESS_SECRET=generate_a_strong_random_string_for_access_tokens_at_least_32_chars
JWT_REFRESH_SECRET=generate_a_strong_random_string_for_refresh_tokens_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OAuth (Google) ────────────────────────────────────────────────
# Comma-separated list of allowed client IDs (web / iOS / Android).
GOOGLE_CLIENT_IDS=your_google_web_client_id.apps.googleusercontent.com

# ─── Security ──────────────────────────────────────────────────────
# Comma-separated list of allowed image hosts for /logs/analyze-menu-image.
# Defaults to your Supabase host if left empty.
ALLOWED_IMAGE_HOSTS=

# CORS origins (comma-separated). Empty = reject all (use only for native apps).
CORS_ORIGIN=

# ─── Email (Resend) ──────────────────────────────────────────────────
# Optional in dev: leave empty to use the console transport.
# Required in production for password reset / email verification to actually deliver.
RESEND_API_KEY=
EMAIL_FROM=no-reply@bioma.app
EMAIL_LOG_ONLY=false

# ─── Frontend integration ───────────────────────────────────────────
# Used to build absolute deep links in transactional emails
# (password reset, email verification). Must match the deployed Expo app origin.
FRONTEND_URL=https://bioma.app

# ─── Monitoring (optional) ──────────────────────────────────────────
SENTRY_DSN=https://public@o0.ingest.sentry.io/0
