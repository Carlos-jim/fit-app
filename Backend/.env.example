# Backend environment variables for Bioma
# Copy this file to .env and fill in the real values.
# NEVER commit .env to Git.

# Database
# Use the pooled connection string from Neon: add -pooler before the first dot.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Storage
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=fit_bucket
STORAGE_SIGNED_UPLOAD_TTL_SECONDS=7200

# Server
PORT=3000
NODE_ENV=development

# Auth (generate strong random strings in production)
JWT_ACCESS_SECRET=generate_a_strong_random_string_for_access_tokens
JWT_REFRESH_SECRET=generate_a_strong_random_string_for_refresh_tokens

# OAuth
GOOGLE_CLIENT_IDS=your_google_web_client_id.apps.googleusercontent.com

# Monitoring (optional)
SENTRY_DSN=https://public@o0.ingest.sentry.io/0
