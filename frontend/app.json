{
  "expo": {
    "name": "Bioma",
    "slug": "bioma",
    "scheme": "bioma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#120F0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bioma.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#120F0A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.bioma.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bioma usa tu ubicacion para calcular la salida y puesta del sol de tu ciudad y ajustar tus habitos circadianos.",
          "locationAlwaysAndWhenInUsePermission": "Bioma usa tu ubicacion para sincronizar tus habitos con la luz solar local."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bioma usa la camara para escanear comidas y codigos de barra."
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "bioma",
          "project": "bioma-mobile",
          "url": "https://sentry.io/"
        }
      ],
      "expo-secure-store"
    ],
    "scheme": ["bioma"],
    "deepLinking": {
      "enabled": true,
      "schemes": ["bioma"]
    }
  }
}
