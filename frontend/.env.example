# Frontend environment variables for Bioma (Expo)
# Copy this file to .env and fill in the real values.
# NEVER commit .env to Git.

# API
# Use your production backend URL or local machine IP for development.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.11:3000

# Sentry (optional)
EXPO_PUBLIC_SENTRY_DSN=https://public@o0.ingest.sentry.io/0

# Defaults for onboarding/login forms
EXPO_PUBLIC_DEFAULT_EMAIL=
EXPO_PUBLIC_DEFAULT_NAME=

# Google OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
